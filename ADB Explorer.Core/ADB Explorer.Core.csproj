<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-free code shared by the WPF app and future non-Windows UIs.
       Must not reference WPF, WinRT, Vanara or other Windows-only APIs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ADB_Explorer</RootNamespace>
    <AssemblyName>ADB_Explorer.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <Configurations>Debug;Release;Deploy</Configurations>
    <!-- Use Roslyn (csc) instead of legacy al.exe for satellite assemblies; al.exe rejects /platform:arm64 (AL1012) -->
    <GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Deploy'">
    <DefineConstants>$(DefineConstants);DEPLOY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ADB Explorer" />
    <InternalsVisibleTo Include="ADB_Test" />
  </ItemGroup>

  <!-- Count-dependent strings (Strings.Plurals), translated in Weblate as i18next v4 JSON.
       Embedded in this assembly - no satellite assemblies, so the culture isn't inferred from the name. -->
  <ItemGroup>
    <None Remove="Strings\Plurals\*.json" />
    <EmbeddedResource Include="Strings\Plurals\*.json">
      <LogicalName>ADB_Explorer.Strings.Plurals.%(Filename).json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Weblate creates a language's files before anything is translated. An empty resx would still produce a
       satellite assembly (which lists the language in settings), so empty resx and plurals files are dropped. -->
  <Target Name="DropEmptyTranslations" BeforeTargets="PrepareResourceNames">
    <ItemGroup>
      <_EmptyTranslation Include="@(EmbeddedResource)" Condition="'%(RelativeDir)' == 'Strings\' And '%(Extension)' == '.resx' And $([System.String]::new('%(Filename)').StartsWith('Resources.')) And !$([System.IO.File]::ReadAllText('%(FullPath)').Contains('&lt;data '))" />
      <_EmptyTranslation Include="@(EmbeddedResource)" Condition="'%(RelativeDir)' == 'Strings\Plurals\' And '%(Extension)' == '.json' And '%(Filename)' != 'en' And !$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '&quot;:\s*&quot;[^&quot;]'))" />
      <EmbeddedResource Remove="@(_EmptyTranslation)" />
      <_EmptyResxCulture Include="$([System.String]::new('%(_EmptyTranslation.Filename)').Substring(10))" Condition="'%(_EmptyTranslation.Extension)' == '.resx'" />
    </ItemGroup>
    <Message Importance="high" Text="Dropping empty translation: %(_EmptyTranslation.Identity)" Condition="'@(_EmptyTranslation)' != ''" />
  </Target>

  <!-- Removes a satellite assembly left over from a build made before the language's files became empty -->
  <Target Name="DeleteEmptyTranslationSatellites" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="DropEmptyTranslations">
    <Delete Files="$(OutDir)%(_EmptyResxCulture.Identity)\$(AssemblyName).resources.dll" Condition="'@(_EmptyResxCulture)' != ''" />
  </Target>

  <ItemGroup>
    <Compile Update="Strings\Resources.Designer.cs">
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <EmbeddedResource Update="Strings\Resources.resx">
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>
