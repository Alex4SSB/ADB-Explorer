<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <Platforms>x64</Platforms>

    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>

    <Configurations>Debug;Release;Deploy</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADB Explorer\ADB Explorer.csproj" />
  </ItemGroup>

  <!-- The app references AdvancedSharpAdbClient as a raw DLL (our fork), which, unlike
       the NuGet package, doesn't flow to this project through the ProjectReference. -->
  <ItemGroup>
    <Reference Include="AdvancedSharpAdbClient">
      <HintPath>..\ADB Explorer\Libs\AdvancedSharpAdbClient\AdvancedSharpAdbClient.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\ADB Explorer\FaroCollector.url')">
    <Content Include="..\ADB Explorer\FaroCollector.url" Link="FaroCollector.url" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
