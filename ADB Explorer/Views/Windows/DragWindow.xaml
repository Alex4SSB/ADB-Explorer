<Popup
    x:Class="ADB_Explorer.Views.Windows.DragWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
    xmlns:local="clr-namespace:ADB_Explorer.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ADB_Explorer.ViewModels"
    x:Name="dragWin"
    d:DataContext="{d:DesignInstance local:DragWindow,
                                     IsDesignTimeCreatable=True}"
    AllowsTransparency="True"
    Focusable="False"
    IsHitTestVisible="False"
    Opened="Popup_Opened"
    Placement="AbsolutePoint"
    PopupAnimation="None"
    StaysOpen="True"
    mc:Ignorable="d">
    <Border
        x:Name="MainBorder"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="Transparent"
        DataContext="{Binding ElementName=dragWin}"
        MouseUp="Border_MouseUp"
        Opacity="1">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.CopyPaste}, Path=DragBitmap}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid
            x:Name="ContentGrid"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!--  The image's halves, then room for a source pill that wraps below it  -->
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding ViewModel.DragImageHalfHeight}" />
                <RowDefinition Height="{Binding ViewModel.DragImageHalfHeight}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="ImageHost"
                Grid.RowSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Image
                    x:Name="DragImage"
                    Width="{Binding ViewModel.DragImageWidth}"
                    Height="{Binding ViewModel.DragImageHeight}"
                    FlowDirection="LeftToRight"
                    IsHitTestVisible="False"
                    Opacity="{Binding ViewModel.DragImageOpacity}"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Source={x:Static Member=models:Data.CopyPaste}, Path=DragBitmap}"
                    Stretch="Fill">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.CopyPaste}, Path=IsContentDrag}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <!--  What a content drag drags, drawn from its type's template instead of an image  -->
                <ContentPresenter
                    x:Name="DragContent"
                    Width="{Binding ElementName=dragWin, Path=ViewModel.DragImageWidth}"
                    Height="{Binding ElementName=dragWin, Path=ViewModel.DragImageHeight}"
                    Content="{Binding Source={x:Static Member=models:Data.CopyPaste}, Path=DragContent}"
                    IsHitTestVisible="False"
                    Opacity="{Binding ElementName=dragWin, Path=ViewModel.DragImageOpacity}">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.CopyPaste}, Path=IsContentDrag}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                    <ContentPresenter.Resources>
                        <!--  A dragged device shows its navigation tree row, whether it's dragged by that or by its card  -->
                        <DataTemplate DataType="{x:Type viewModels:LogicalDeviceViewModel}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DeviceDragRowTemplate}" />
                        </DataTemplate>
                        <!--  A dragged page shows its icon and name  -->
                        <DataTemplate DataType="{x:Type models:AdbLocation}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageDragTemplate}" />
                        </DataTemplate>
                        <!--  A dragged tab shows its header, as an inactive tab in the strip  -->
                        <DataTemplate DataType="{x:Type models:ExplorerInstance}">
                            <Border
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                CornerRadius="6"
                                TextElement.FontSize="{DynamicResource ControlContentThemeFontSize}"
                                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <Border
                                    Padding="6,0"
                                    Background="{DynamicResource NavigationViewContentBackground}"
                                    CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Content="{Binding TabIcon.IconContent}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding TabDisplayName}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>
                <TextBlock
                    x:Name="DebugLabel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    Foreground="Black"
                    Text="DEBUG">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsDebug}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <!--  The source's name or item count, its top at the image's middle as File Explorer's  -->
            <Border
                Grid.Row="1"
                Grid.RowSpan="2"
                MaxWidth="{Binding ElementName=ImageHost, Path=ActualWidth}"
                Padding="8,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.SourcePill}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <emoji:TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding ViewModel.SourcePill}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Border>
            <Border
                Grid.RowSpan="2"
                Grid.Column="1"
                Margin="6,0,0,0"
                Padding="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.IsTooltipShown}" Value="False">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon
                        Width="16"
                        Glyph="{Binding ViewModel.TooltipGlyph}"
                        Margin="0,0,2,0"
                        HorizontalAlignment="Left"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        RenderTransformOrigin="0.5,0.5">
                        <ui:FontIcon.Style>
                            <Style BasedOn="{StaticResource GlyphFont}" TargetType="ui:FontIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsRTL, Mode=OneTime}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="-1" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:FontIcon.Style>
                    </ui:FontIcon>
                    <emoji:TextBlock
                        Grid.Column="1"
                        ForegroundRanges="{Binding ViewModel.TooltipInsertRanges}"
                        Foreground="DodgerBlue"
                        RangeForeground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding ViewModel.TooltipText}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Popup>
