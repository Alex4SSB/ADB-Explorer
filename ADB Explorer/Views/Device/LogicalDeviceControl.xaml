<UserControl
    x:Class="ADB_Explorer.Views.LogicalDeviceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ADB_Explorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ADB_Explorer.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:strings="clr-namespace:ADB_Explorer.Strings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:ADB_Explorer.ViewModels"
    xmlns:views="clr-namespace:ADB_Explorer.Views"
    d:DataContext="{d:DesignInstance Type=viewmodels:LogicalDeviceViewModel}"
    mc:Ignorable="d">
    <ui:CardControl Style="{StaticResource DeviceExpanderStyle}">
        <ui:CardControl.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:FluentPathIcon Style="{StaticResource DeviceStatusPathIcon}" />
                    <TextBlock Grid.Column="1" FlowDirection="LeftToRight">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource DeviceNameTextBlockStyle}" TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Name}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Unauthorized">
                                        <Setter Property="Text" Value="{Binding Source={x:Static Member=strings:Resources.S_DEVICE_UNAUTH_NONAME}}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Type}" Value="Service" />
                                            <Condition Binding="{Binding Name}" Value="" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="{Binding Source={x:Static Member=strings:Resources.S_SERVICE_NONAME}}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Separator Grid.Row="1" Margin="0,4,0,8" />
                <controls:SimpleStackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Grid>
                        <Grid
                            Width="28"
                            Height="28"
                            VerticalAlignment="Top"
                            ToolTip="{Binding Tooltip}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsConnectionIcons}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding TypeIconContent}" />
                        </Grid>
                        <!--  One column per transport: USB with its negotiated version, Wi-Fi / mDNS with the link speed  -->
                        <controls:SimpleStackPanel
                            Orientation="Horizontal"
                            Spacing="10"
                            Visibility="{Binding ShowsConnectionIcons, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel ToolTip="{Binding Tooltip}" Visibility="{Binding HasUsbConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Height="24">
                                    <controls:FluentPathIcon
                                        Width="28"
                                        Height="16"
                                        Data="{x:Static controls:FluentPathGeometries.UsbDevice}"
                                        FlowDirection="LeftToRight" />
                                </Grid>
                                <TextBlock
                                    FlowDirection="LeftToRight"
                                    Style="{StaticResource DeviceIconCaptionStyle}"
                                    Text="{Binding UsbVersion}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding HasWifiConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid
                                    Width="24"
                                    Height="24"
                                    ToolTip="{Binding Source={x:Static Member=strings:Resources.S_TYPE_WIFI}}">
                                    <controls:FluentPathIcon
                                        Width="24"
                                        Height="24"
                                        Data="{x:Static controls:FluentPathGeometries.Wifi}"
                                        FlowDirection="LeftToRight">
                                        <controls:FluentPathIcon.Style>
                                            <Style BasedOn="{StaticResource BaseIconPathStyle}" TargetType="controls:FluentPathIcon">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMdnsConnection}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:FluentPathIcon.Style>
                                    </controls:FluentPathIcon>
                                    <controls:WifiSearchIcon
                                        FlowDirection="LeftToRight"
                                        Size="24"
                                        Visibility="{Binding HasMdnsConnection, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                                <TextBlock
                                    FlowDirection="LeftToRight"
                                    Style="{StaticResource DeviceIconCaptionStyle}"
                                    Text="{Binding WifiLinkSpeed}" />
                            </StackPanel>
                        </controls:SimpleStackPanel>
                    </Grid>
                    <ui:FontIcon
                        Height="24"
                        VerticalAlignment="Top"
                        Glyph="&#xE7EF;"
                        Style="{StaticResource RootIconStyle}" />
                    <Grid VerticalAlignment="Top">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <views:CompactBatteryControl DataContext="{Binding Battery}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Top">
                        <StackPanel.ToolTip>
                            <TextBlock Text="{Binding AndroidVersionString, StringFormat=Android {0}}" />
                        </StackPanel.ToolTip>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AndroidVersion}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Height="24">
                            <controls:FluentPathIcon
                                Width="24"
                                Height="14"
                                Data="{x:Static controls:FluentPathGeometries.AndroidHead}"
                                FlowDirection="LeftToRight" />
                        </Grid>
                        <TextBlock
                            FlowDirection="LeftToRight"
                            Style="{StaticResource DeviceIconCaptionStyle}"
                            Text="{Binding AndroidVersion}" />
                    </StackPanel>
                </controls:SimpleStackPanel>
            </Grid>
        </ui:CardControl.Header>
        <Grid Style="{StaticResource DeviceContentGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border
                Padding="0,2"
                BorderBrush="{DynamicResource SeparatorForeground}"
                BorderThickness="1"
                CornerRadius="4">
                <controls:AdbMenu>
                    <controls:AdbMenu.Resources>
                        <Style BasedOn="{StaticResource DisabledGlyphStyle}" TargetType="ui:FontIcon">
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Margin" Value="-5,2" />
                        </Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundBaseHighBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </controls:AdbMenu.Resources>
                    <controls:AdbMenu.Style>
                        <Style BasedOn="{StaticResource AdbMenuStyle}" TargetType="controls:AdbMenu">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Height" Value="32" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Ok">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                                <!-- An unauthorized or offline device must still be removable, to disconnect and retry -->
                                <DataTrigger Binding="{Binding RemoveCommand.IsEnabled}" Value="True">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:AdbMenu.Style>
                    <controls:AdbMenuItem Height="38" ToolTip="{Binding Source={x:Static strings:Resources.S_ROOT_FORBID_TITLE}}">
                        <controls:AdbMenuItem.Style>
                            <Style BasedOn="{StaticResource DeviceActionsMenuItemStyle}" TargetType="controls:AdbMenuItem">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Sideload">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:AdbMenuItem.Style>
                        <controls:AdbMenuItem.Header>
                            <ui:FontIcon
                                Margin="-4,-8"
                                FontSize="18"
                                Glyph="&#xE7EF;"
                                Style="{StaticResource GlyphFont}" />
                        </controls:AdbMenuItem.Header>
                        <controls:AdbMenuItem IsEnabled="False">
                            <controls:AdbMenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="Bold">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource StringFormatConverter}" ConverterParameter="{x:Static strings:Resources.S_ROOT_STATUS_TITLE}">
                                                <Binding Path="RootString" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontWeight="Bold" Style="{StaticResource RecoveryRootStatusStyle}">
                                        <Run Text=" - " />
                                        <Run Text="{Binding Mode=OneWay, Source={x:Static Member=strings:Resources.S_RECOVERY_MODE}}" />
                                    </TextBlock>
                                </StackPanel>
                            </controls:AdbMenuItem.Header>
                        </controls:AdbMenuItem>
                        <Separator IsEnabled="False">
                            <Separator.Style>
                                <Style BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" TargetType="Separator">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Root}" Value="Forbidden">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Recovery">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Separator.Style>
                        </Separator>
                        <controls:AdbMenuItem Command="{Binding ToggleRootCommand.Command}">
                            <controls:AdbMenuItem.Style>
                                <Style BasedOn="{StaticResource AdbMenuItemHoverStyle}" TargetType="controls:AdbMenuItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Root}" Value="Forbidden">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Recovery">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:AdbMenuItem.Style>
                            <controls:AdbMenuItem.Header>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource DisabledTextBlockStyle}" TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Mode=OneWay, Source={x:Static Member=strings:Resources.S_BUTTON_ENABLE}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Root}" Value="Enabled">
                                                    <Setter Property="Text" Value="{Binding Mode=OneWay, Source={x:Static Member=strings:Resources.S_BUTTON_DISABLE}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </controls:AdbMenuItem.Header>
                        </controls:AdbMenuItem>
                    </controls:AdbMenuItem>
                    <controls:AdbMenuItem Height="38" ToolTip="{Binding Mode=OneWay, Source={x:Static Member=strings:Resources.S_DEVICE_REBOOT_TITLE}}">
                        <controls:AdbMenuItem.Style>
                            <Style BasedOn="{StaticResource DeviceActionsMenuItemStyle}" TargetType="controls:AdbMenuItem">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Ok">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:AdbMenuItem.Style>
                        <controls:AdbMenuItem.Resources>
                            <helpers:BindingProxy x:Key="DeviceProxy" Data="{Binding}" />
                        </controls:AdbMenuItem.Resources>
                        <controls:AdbMenuItem.ItemsSource>
                            <CompositeCollection>
                                <controls:AdbMenuItem Header="{x:Static strings:Resources.S_DEVICE_REBOOT_TITLE}" IsEnabled="False" />
                                <Separator />
                                <CollectionContainer Collection="{Binding Data.RebootCommands, Source={StaticResource DeviceProxy}}" />
                            </CompositeCollection>
                        </controls:AdbMenuItem.ItemsSource>
                        <controls:AdbMenuItem.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                <Setter Property="Command" Value="{Binding Command}" />
                            </Style>
                        </controls:AdbMenuItem.ItemContainerStyle>
                        <controls:AdbMenuItem.Header>
                            <ui:FontIcon
                                Margin="-4,-8"
                                FontSize="18"
                                Glyph="&#xE777;"
                                Style="{StaticResource GlyphFont}" />
                        </controls:AdbMenuItem.Header>
                    </controls:AdbMenuItem>
                    <controls:AdbMenuItem
                        Height="38"
                        Command="{Binding RemoveCommand.Command}"
                        ToolTip="{Binding RemoveCommand.Description}">
                        <controls:AdbMenuItem.Style>
                            <Style BasedOn="{StaticResource DeviceActionsMenuItemStyle}" TargetType="controls:AdbMenuItem">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RemoveCommand.IsEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:AdbMenuItem.Style>
                        <controls:AdbMenuItem.Header>
                            <ui:FontIcon
                                Margin="-4,-8,-6,-8"
                                FontSize="18"
                                Glyph="&#xE711;"
                                Style="{StaticResource GlyphFont}" />
                        </controls:AdbMenuItem.Header>
                    </controls:AdbMenuItem>
                    <controls:AdbMenuItem
                        Height="38"
                        Command="{Binding SideloadCommand.Command}"
                        ToolTip="{Binding Mode=OneWay, Source={x:Static Member=strings:Resources.S_REBOOT_SIDELOAD}}">
                        <controls:AdbMenuItem.Style>
                            <Style BasedOn="{StaticResource DeviceActionsMenuItemStyle}" TargetType="controls:AdbMenuItem">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SideloadCommand.IsEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:AdbMenuItem.Style>
                        <controls:AdbMenuItem.Header>
                            <ui:FontIcon
                                Margin="-4,-8"
                                FontSize="18"
                                Glyph="&#xE67A;"
                                Style="{StaticResource GlyphFont}" />
                        </controls:AdbMenuItem.Header>
                    </controls:AdbMenuItem>
                </controls:AdbMenu>
            </Border>
            <ui:Button
                Grid.Column="1"
                HorizontalAlignment="Right"
                Appearance="Primary"
                Command="{Binding BrowseCommand.Command}"
                Content="{Binding Source={x:Static Member=strings:Resources.S_BUTTON_BROWSE}}"
                Style="{StaticResource DeviceTextButtonStyle}" />
        </Grid>
    </ui:CardControl>
</UserControl>
