<UserControl
    x:Class="ADB_Explorer.Controls.TitleBarMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ADB_Explorer.Helpers"
    xmlns:local="clr-namespace:ADB_Explorer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:strings="clr-namespace:ADB_Explorer.Strings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:windows="clr-namespace:ADB_Explorer.ViewModels.Windows"
    x:Name="titleBarMenu"
    d:DataContext="{d:DesignInstance Type=windows:MainWindowViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ToolTip x:Key="TransferIndicatorToolTip">
            <Grid>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServerUnresponsive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding Source={x:Static Member=strings:Resources.S_ADB_DISK_USAGE}}" />
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource StringFormatConverter}" ConverterParameter="{x:Static strings:Resources.S_DISK_USAGE_READ}">
                                <Binding Path="AdbReadRate" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource StringFormatConverter}" ConverterParameter="{x:Static strings:Resources.S_DISK_USAGE_WRITE}">
                                <Binding Path="AdbWriteRate" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServerUnresponsive}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontWeight="Bold"
                        Text="{Binding Source={x:Static Member=strings:Resources.S_SERVER_UNRESPONSIVE}}" />
                    <Separator Margin="-6,4" />
                    <TextBlock Text="{Binding LastResponse}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Text="{Binding Source={x:Static Member=strings:Resources.S_TOOLTIP_MORE_INFO}}" />
                </StackPanel>
            </Grid>
        </ToolTip>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="local:TitleBarMenu">
            <Setter Property="ServerUnresponsive" Value="{Binding ServerUnresponsive}" />
        </Style>
    </UserControl.Style>
    <local:AdbMenu d:Background="#202020" Style="{StaticResource AdbMenuStyle}">
        <local:AdbMenuItem
            x:Name="TransferMenuItem"
            d:Visibility="Visible"
            ToolTip="{StaticResource TransferIndicatorToolTip}"
            ToolTipService.InitialShowDelay="0"
            ToolTipService.Placement="Bottom"
            ToolTipService.ShowDuration="60000">
            <local:AdbMenuItem.Style>
                <Style BasedOn="{StaticResource AdbMenuItemStyle}" TargetType="local:AdbMenuItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static Member=helpers:AdbHelper.CurrentAdbState}, Path=Status}" Value="Valid">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:AdbMenuItem.Style>
            <local:AdbMenuItem.Header>
                <Grid Margin="-4" FlowDirection="LeftToRight">
                    <ui:FontIcon
                        Margin="0,0,0,0"
                        d:Foreground="White"
                        FontSize="24"
                        Foreground="{DynamicResource SelectedForeground}"
                        Glyph="&#xE965;" />
                    <Grid Margin="0,-10,-10,0" d:Visibility="Hidden">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerUnresponsive}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ui:FontIcon
                            d:Foreground="#202020"
                            FontSize="16"
                            Foreground="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            Glyph="&#xF136;" />
                        <ui:FontIcon
                            Margin="0,1.5,0,0"
                            d:Foreground="#FF99A4"
                            FontSize="14"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Glyph="&#xEB90;" />
                    </Grid>
                    <Grid Margin="-27,0,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerUnresponsive}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Path
                            Width="10"
                            Height="10"
                            d:Stroke="White"
                            Data="M5.21367 1.45866C5.56266 0.847113 6.43733 0.847113 6.78633 1.45866L10.8776 8.62781C11.2259 9.23809 10.7893 10 10.0913 10H1.9087C1.2107 10 0.774094 9.23809 1.12237 8.62781L5.21367 1.45866ZM6 2.11928L2.08308 8.98286H9.91692L6 2.11928Z"
                            Stretch="Uniform"
                            StrokeThickness="1">
                            <Path.Style>
                                <Style BasedOn="{StaticResource MonochromeIconPathStrokeStyle}" TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdbReadActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path
                            Width="10"
                            Height="10"
                            d:Fill="#4CC2FF"
                            d:Stroke="#4CC2FF"
                            Data="M6.78633 1.45866C6.43733 0.847113 5.56266 0.847113 5.21367 1.45866L1.12237 8.62781C0.774094 9.23809 1.2107 10 1.9087 10H1.9365L1.94138 10H10.0576L10.0625 10H10.0913C10.7893 10 11.2259 9.23809 10.8776 8.62781L6.78633 1.45866Z"
                            Stretch="Uniform"
                            StrokeThickness="1">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource AccentButtonBackground}" />
                                    <Setter Property="Stroke" Value="{DynamicResource AccentButtonBackground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdbReadActive}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsHighContrast}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SelectedForeground}" />
                                            <Setter Property="Stroke" Value="{DynamicResource SelectedForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <Grid Margin="26,0,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerUnresponsive}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Path
                            Width="10"
                            Height="10"
                            d:Stroke="White"
                            Data="M6.78633 10.5413C6.43733 11.1529 5.56266 11.1529 5.21367 10.5413L1.12237 3.37219C0.774094 2.76191 1.21071 2 1.9087 2L10.0913 2C10.7893 2 11.2259 2.76191 10.8776 3.37219L6.78633 10.5413ZM6 9.88072L9.91692 3.01714L2.08308 3.01714L6 9.88072Z"
                            Stretch="Uniform"
                            StrokeThickness="1">
                            <Path.Style>
                                <Style BasedOn="{StaticResource MonochromeIconPathStrokeStyle}" TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdbWriteActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path
                            Width="10"
                            Height="10"
                            d:Fill="#4CC2FF"
                            d:Stroke="#4CC2FF"
                            Data="M5.21367 10.5414C5.56266 11.1529 6.43733 11.1529 6.78633 10.5414L10.8776 3.37221C11.2259 2.76192 10.7893 2.00001 10.0913 2.00001L10.0635 2.00001L10.0586 2L1.94235 2L1.93748 2.00001L1.9087 2.00001C1.21071 2.00001 0.774094 2.76192 1.12237 3.3722L5.21367 10.5414Z"
                            Stretch="Uniform"
                            StrokeThickness="1">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource AccentButtonBackground}" />
                                    <Setter Property="Stroke" Value="{DynamicResource AccentButtonBackground}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdbWriteActive}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsHighContrast}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SelectedForeground}" />
                                            <Setter Property="Stroke" Value="{DynamicResource SelectedForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Grid>
            </local:AdbMenuItem.Header>
        </local:AdbMenuItem>
        <local:AdbMenuItem ItemsSource="{Binding Notifications}" ToolTip="{Binding Source={x:Static Member=strings:Resources.S_NOTIFICATIONS_TITLE}}">
            <local:AdbMenuItem.Style>
                <Style BasedOn="{StaticResource AdbMenuItemStyle}" TargetType="local:AdbMenuItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notifications.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:AdbMenuItem.Style>
            <local:AdbMenuItem.ItemContainerStyle>
                <Style BasedOn="{StaticResource AdbMenuItemStyle}" TargetType="local:AdbMenuItem">
                    <Setter Property="Header" Value="{Binding Title}" />
                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                    <Setter Property="Command" Value="{Binding Command}" />
                </Style>
            </local:AdbMenuItem.ItemContainerStyle>
            <local:AdbMenuItem.Header>
                <Grid Margin="0,-4,-4,-2">
                    <Path
                        Width="22"
                        Height="22"
                        Margin="0,4,4,0"
                        d:Fill="White"
                        Data="M12.0001 1.99609C16.05 1.99609 19.3568 5.19084 19.4959 9.24515L19.5001 9.49609V13.5931L20.8801 16.7491C20.9492 16.907 20.9848 17.0775 20.9848 17.2499C20.9848 17.9402 20.4252 18.4999 19.7348 18.4999L15.0001 18.5014C15.0001 20.1582 13.657 21.5014 12.0001 21.5014C10.4024 21.5014 9.09645 20.2524 9.0052 18.6776L8.99966 18.4991L4.27498 18.4999C4.10364 18.4999 3.93413 18.4646 3.77697 18.3964C3.14377 18.1213 2.85342 17.3851 3.12846 16.7519L4.50011 13.594V9.49599C4.50071 5.3412 7.8522 1.99609 12.0001 1.99609ZM13.4997 18.4991L10.5001 18.5014C10.5001 19.3298 11.1717 20.0014 12.0001 20.0014C12.7798 20.0014 13.4206 19.4065 13.4932 18.6458L13.4997 18.4991ZM12.0001 3.49609C8.67995 3.49609 6.00059 6.17035 6.00011 9.49609V13.9057L4.65613 16.9999H19.3526L18.0001 13.9067L18.0002 9.50895L17.9965 9.28375C17.8854 6.05027 15.2417 3.49609 12.0001 3.49609Z"
                        Stretch="Uniform"
                        Style="{StaticResource MonochromeIconPathStyle}" />
                    <Border
                        Width="16"
                        Height="15"
                        Margin="8,0,0,4"
                        BorderBrush="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderThickness="2"
                        CornerRadius="30">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                <Style.Triggers>
                                    <!--  In HC, the caution-amber badge fill isn't a themed HC color; use the title bar's own color instead, matching the bell body/disk-usage arrows' title-bar-derived coloring.  -->
                                    <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsHighContrast}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TitleBarBackgroundBrush}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(helpers:StyleHelper.IsMenuHighlighted)}" Value="True" />
                                            <Condition Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsHighContrast}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!--  Foreground matches the disk-usage body/arrows' own title-bar-derived FG, per the same convention.  -->
                        <TextBlock
                            Margin="0,0,0,1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{Binding Notifications.Count}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsHighContrast}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </local:AdbMenuItem.Header>
        </local:AdbMenuItem>
        <local:AdbMenuItem
            Command="{x:Static local:TitleBarMenu.ReportIssueCommand}"
            Style="{StaticResource AdbMenuItemStyle}"
            ToolTip="{Binding Source={x:Static Member=strings:Resources.S_REPORT_ISSUE}}">
            <local:AdbMenuItem.Header>
                <!--  ic_fluent_bug_20_regular  -->
                <Path
                    Width="20"
                    Height="20"
                    Margin="-2"
                    d:Fill="White"
                    Data="M9 2.5C9 2.22386 8.77614 2 8.5 2C8.22386 2 8 2.22386 8 2.5V3C8 3.39716 8.11577 3.76729 8.3154 4.07847C6.98842 4.38821 6 5.57867 6 7H5.5C4.67157 7 4 6.32843 4 5.5V3.5C4 3.22386 3.77614 3 3.5 3C3.22386 3 3 3.22386 3 3.5V5.5C3 6.88071 4.11929 8 5.5 8H6V9.5H2.5C2.22386 9.5 2 9.72386 2 10C2 10.2761 2.22386 10.5 2.5 10.5H6V12H5.5C4.11929 12 3 13.1193 3 14.5V16.5C3 16.7761 3.22386 17 3.5 17C3.77614 17 4 16.7761 4 16.5V14.5C4 13.6716 4.67157 13 5.5 13H6C6 15.2091 7.79086 17 10 17C12.2091 17 14 15.2091 14 13H14.5C15.3284 13 16 13.6716 16 14.5V16.5C16 16.7761 16.2239 17 16.5 17C16.7761 17 17 16.7761 17 16.5V14.5C17 13.1193 15.8807 12 14.5 12H14V10.5H17.5C17.7761 10.5 18 10.2761 18 10C18 9.72386 17.7761 9.5 17.5 9.5H14V8H14.5C15.8807 8 17 6.88071 17 5.5V3.5C17 3.22386 16.7761 3 16.5 3C16.2239 3 16 3.22386 16 3.5V5.5C16 6.32843 15.3284 7 14.5 7H14C14 5.57867 13.0116 4.38821 11.6846 4.07847C11.8842 3.76729 12 3.39716 12 3V2.5C12 2.22386 11.7761 2 11.5 2C11.2239 2 11 2.22386 11 2.5V3C11 3.55228 10.5523 4 10 4C9.44772 4 9 3.55228 9 3V2.5ZM13 7V13C13 14.6569 11.6569 16 10 16C8.34315 16 7 14.6569 7 13V7C7 5.89543 7.89543 5 9 5H11C12.1046 5 13 5.89543 13 7Z"
                    Stretch="Uniform"
                    Style="{StaticResource MonochromeIconPathStyle}" />
            </local:AdbMenuItem.Header>
        </local:AdbMenuItem>
    </local:AdbMenu>
</UserControl>
