<UserControl
    x:Class="ADB_Explorer.Controls.ThumbsSizeSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ADB_Explorer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:strings="clr-namespace:ADB_Explorer.Strings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:ADB_Explorer.ViewModels"
    x:Name="tsz"
    mc:Ignorable="d">
    <local:AdbMenu
        d:Visibility="Visible"
        DataContext="{Binding ElementName=tsz}"
        Style="{StaticResource AdbMenuStyle}">
        <local:AdbMenuItem ItemsSource="{Binding Items}" ToolTip="{Binding Source={x:Static Member=strings:Resources.S_THUMBSIZE_TOOLTIP}}">
            <local:AdbMenuItem.Header>
                <local:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                    <ContentPresenter Content="{Binding SelectedIcon}" />
                    <TextBlock
                        Margin="0,0,0,2"
                        Style="{StaticResource ToolbarLabelStyle}"
                        Text="{Binding Source={x:Static Member=strings:Resources.S_THUMBSIZE_TITLE}}" />
                    <ui:FontIcon
                        Margin="0,2,0,0"
                        FontSize="8"
                        Glyph="&#xE70D;" />
                </local:SimpleStackPanel>
            </local:AdbMenuItem.Header>
            <local:AdbMenuItem.ItemContainerStyle>
                <Style BasedOn="{StaticResource SelectorMenuItemStyle}" TargetType="local:AdbMenuItem">
                    <Setter Property="ItemsSource" Value="{Binding Children}" />
                </Style>
            </local:AdbMenuItem.ItemContainerStyle>
            <local:AdbMenuItem.ItemTemplate>
                <DataTemplate DataType="viewmodels:SelectorItem">
                    <local:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ContentPresenter Content="{Binding Icon}" />
                        <TextBlock Text="{Binding Name}" />
                    </local:SimpleStackPanel>
                </DataTemplate>
            </local:AdbMenuItem.ItemTemplate>
        </local:AdbMenuItem>
    </local:AdbMenu>
</UserControl>
