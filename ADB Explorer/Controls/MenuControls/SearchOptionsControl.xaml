<UserControl
    x:Class="ADB_Explorer.Controls.SearchOptionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ADB_Explorer.Helpers"
    xmlns:local="clr-namespace:ADB_Explorer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:strings="clr-namespace:ADB_Explorer.Strings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:ADB_Explorer.ViewModels"
    x:Name="searchOptions"
    mc:Ignorable="d">
    <UserControl.Style>
        <Style TargetType="local:SearchOptionsControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSearchOptionsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <local:AdbMenu d:Visibility="Visible" DataContext="{Binding ElementName=searchOptions}">
        <local:AdbMenu.Style>
            <Style BasedOn="{StaticResource AdbMenuStyle}" TargetType="local:AdbMenu">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(helpers:InstanceHelper.Instance).FileList.Actions.IsExplorerVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </local:AdbMenu.Style>
        <local:AdbMenuItem
            ItemContainerStyle="{StaticResource SelectorMenuItemStyle}"
            ItemsSource="{Binding Items}"
            ToolTip="{Binding Source={x:Static Member=strings:Resources.S_SEARCH_OPTIONS_INFO}}">
            <local:AdbMenuItem.Header>
                <local:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                    <local:SearchSettingsIcon Margin="0,-2,0,0" Size="20" />
                    <TextBlock Margin="0,0,0,2" Text="{Binding Source={x:Static Member=strings:Resources.S_SEARCH_OPTIONS}}" />
                    <ui:FontIcon
                        Margin="0,2,0,0"
                        FontSize="8"
                        Glyph="&#xE70D;" />
                </local:SimpleStackPanel>
            </local:AdbMenuItem.Header>
            <local:AdbMenuItem.ItemTemplate>
                <DataTemplate DataType="viewmodels:SelectorItem">
                    <local:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ContentPresenter Content="{Binding Icon}" />
                        <TextBlock Text="{Binding Name}" />
                    </local:SimpleStackPanel>
                </DataTemplate>
            </local:AdbMenuItem.ItemTemplate>
        </local:AdbMenuItem>
        <local:AdbMenuItem
            Command="{Binding CloseSearchAction.Command}"
            ToolTip="{Binding Source={x:Static Member=strings:Resources.S_CLOSE_SEARCH_INFO}}"
            Visibility="{Binding IsCloseSearchVisible, Converter={StaticResource BoolToVisibility}}">
            <local:AdbMenuItem.Header>
                <local:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FontIcon
                        FontSize="22"
                        Glyph="&#xE947;"
                        Style="{StaticResource IconAccentGlyphStyle}" />
                    <TextBlock Text="{Binding Source={x:Static Member=strings:Resources.S_EXIT_SEARCH}}" />
                </local:SimpleStackPanel>
            </local:AdbMenuItem.Header>
        </local:AdbMenuItem>
    </local:AdbMenu>
</UserControl>
