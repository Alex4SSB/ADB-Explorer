<UserControl
    x:Class="ADB_Explorer.Controls.SortingSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ADB_Explorer.Helpers"
    xmlns:local="clr-namespace:ADB_Explorer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:strings="clr-namespace:ADB_Explorer.Strings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="sortingSelector"
    mc:Ignorable="d">
    <local:AdbMenu DataContext="{Binding ElementName=sortingSelector}">
        <local:AdbMenu.Style>
            <Style BasedOn="{StaticResource AdbMenuStyle}" TargetType="local:AdbMenu">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(helpers:InstanceHelper.Instance).FileList.Actions.IsExplorerVisible}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </local:AdbMenu.Style>
        <local:AdbMenuItem ItemsSource="{Binding Items}" ToolTip="{Binding Source={x:Static Member=strings:Resources.S_SORT}}">
            <local:AdbMenuItem.Resources>
                <ui:FontIcon
                    x:Key="ThumbCheckedIcon"
                    Margin="14,0"
                    x:Shared="False"
                    FontSize="6"
                    Glyph="&#xF137;">
                    <ui:FontIcon.Style>
                        <Style BasedOn="{StaticResource GlyphFont}" TargetType="ui:FontIcon">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:FontIcon.Style>
                </ui:FontIcon>
            </local:AdbMenuItem.Resources>
            <local:AdbMenuItem.Header>
                <local:SimpleStackPanel Orientation="Horizontal" Spacing="6">
                    <local:SortDirectionIcon Direction="{Binding SortDirection}" />
                    <TextBlock
                        Margin="0,0,0,2"
                        Style="{StaticResource ToolbarLabelStyle}"
                        Text="{Binding Source={x:Static Member=strings:Resources.S_SORT}}" />
                    <ui:FontIcon
                        Margin="0,2,0,0"
                        FontSize="8"
                        Glyph="&#xE70D;" />
                </local:SimpleStackPanel>
            </local:AdbMenuItem.Header>
            <local:AdbMenuItem.ItemContainerStyle>
                <!--  BasedOn=AdbMenuItemStyle so leaf items pick up the Role=SubmenuItem template that pairs Background+Foreground on real IsMouseOver (see AdbMenuItemHoverStyle's comment); without it these items fell back to the native MenuItem template, whose checked-indicator and header text never reacted to actual hover.  -->
                <Style BasedOn="{StaticResource AdbMenuItemStyle}" TargetType="local:AdbMenuItem">
                    <Setter Property="Icon" Value="{StaticResource ThumbCheckedIcon}" />
                    <Setter Property="Command" Value="{Binding Action.Command}" />
                </Style>
            </local:AdbMenuItem.ItemContainerStyle>
            <local:AdbMenuItem.ItemTemplate>
                <DataTemplate DataType="local:SortingSelector.SortingSelectorItem">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </local:AdbMenuItem.ItemTemplate>
        </local:AdbMenuItem>
    </local:AdbMenu>
</UserControl>
