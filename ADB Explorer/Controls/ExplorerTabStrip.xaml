<UserControl
    x:Class="ADB_Explorer.Controls.ExplorerTabStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ADB_Explorer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:strings="clr-namespace:ADB_Explorer.Strings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="32"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <DockPanel LastChildFill="True">
        <ui:Button
            x:Name="AddTabButton"
            Width="32"
            Height="32"
            Margin="4,0,0,4"
            Padding="0"
            VerticalAlignment="Center"
            Appearance="Transparent"
            BorderThickness="0"
            Click="AddTab_Click"
            CornerRadius="5"
            DockPanel.Dock="Right"
            ToolTip="{x:Static strings:Resources.S_NEW_TAB}">
            <ui:Button.Style>
                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.MainWindowVM}, Path=IsNavigationEnabled}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:Button.Style>
            <ui:SymbolIcon FontSize="14" Symbol="Add16" />
        </ui:Button>

        <ListBox
            x:Name="TabsList"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Tabs}"
            SelectedItem="{Binding ActiveTab, Mode=TwoWay}">
            <!--  No ScrollViewer: it would clip the active tab's flares and its edge flush with the content below.  -->
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:TabStripPanel
                        MaxTabWidth="240"
                        SeparatorBottomInset="6"
                        SeparatorBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="3,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <!--  Idle/hover body, kept clear of the bottom edge the active tab reaches.  -->
                                    <Border
                                        x:Name="Bd"
                                        Margin="0,0,0,6"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True" />
                                    <!--
                                        Same layer and outline as the content surface below, so the two read as one.
                                        Reaches over the surface's border row, which a Border leaves unpainted.
                                    -->
                                    <local:TabFuseBackground
                                        x:Name="Fuse"
                                        CoveredBorderThickness="1"
                                        Fill="{DynamicResource NavigationViewContentBackground}"
                                        IsHitTestVisible="False"
                                        Stroke="{DynamicResource NavigationViewContentGridBorderBrush}"
                                        Visibility="Collapsed" />
                                    <ContentPresenter x:Name="TabContent" Margin="2,0,2,6" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MouseOverBackground}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Fuse" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="TabContent" Property="TextElement.FontWeight" Value="Bold" />
                                        <Setter Property="Panel.ZIndex" Value="1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ExplorerInstance}">
                    <Grid Margin="4,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip
                                            MaxWidth="600"
                                            Content="{Binding RelativeSource={RelativeSource Mode=Self}, Path=PlacementTarget.DataContext.TabTooltipPath}"
                                            FlowDirection="LeftToRight"
                                            Style="{StaticResource FluentTooltipStyle}" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabTooltipPath}" Value="">
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter
                            Grid.Column="0"
                            Width="16"
                            Height="16"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Content="{Binding TabIcon.IconContent}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding TabDisplayName}"
                            TextTrimming="CharacterEllipsis" />

                        <ui:Button
                            Grid.Column="2"
                            Width="22"
                            Height="22"
                            Margin="6,0,0,0"
                            Padding="0"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Click="CloseTab_Click">
                            <ui:Button.Style>
                                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                    <Setter Property="ToolTip" Value="{x:Static strings:Resources.S_CLOSE_TAB}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter Property="ToolTip" Value="{Binding DataContext.CloseTabTooltip, RelativeSource={RelativeSource AncestorType=local:ExplorerTabStrip}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=Items.Count}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <ui:SymbolIcon FontSize="12" Symbol="Dismiss16" />
                        </ui:Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
