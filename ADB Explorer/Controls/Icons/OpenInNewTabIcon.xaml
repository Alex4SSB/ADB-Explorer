        Width="{Binding Size}"
        Height="{Binding Size}"
        DataContext="{Binding ElementName=Icon}"
        Stretch="Uniform">
        <Grid
            Width="{Binding ArtboardSize}"
            Height="{Binding ArtboardSize}"
            Margin="-2,-1,-1,-2">
            <!--  Tabs (monochrome), with the cut-out left for the badge  -->
