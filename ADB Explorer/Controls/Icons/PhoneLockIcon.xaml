<controls:ScaledPathIcon
    x:Class="ADB_Explorer.Controls.PhoneLockIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ADB_Explorer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Icon"
    ArtboardSize="20"
    RtlBehavior="ForceLtr"
    mc:Ignorable="d">
    <Viewbox
        Width="{Binding Size}"
        Height="{Binding Size}"
        DataContext="{Binding ElementName=Icon}"
        Stretch="Uniform">
        <Grid
            Width="{Binding ArtboardSize}"
            Height="{Binding ArtboardSize}"
            Margin="-2">
            <!--  Phone body and home bar (monochrome)  -->
            <Path
                d:Fill="White"
                Data="M5 4C5 2.89543 5.89543 2 7 2H13C14.1046 2 15 2.89543 15 4V9.04148C14.8374 9.0142 14.6704 9 14.5 9C14.3296 9 14.1626 9.0142 14 9.04148V4C14 3.44772 13.5523 3 13 3H7C6.44772 3 6 3.44772 6 4V16C6 16.5523 6.44772 17 7 17H10V18H7C5.89543 18 5 17.1046 5 16V4ZM8.5 14H10V15H8.5C8.22386 15 8 14.7761 8 14.5C8 14.2239 8.22386 14 8.5 14Z"
                Stretch="None"
                Style="{StaticResource MonochromeIconPathStyle}" />
            <!--  Lock badge with shackle and keyhole cut out (caution when enabled)  -->
            <Path
                d:Fill="#FCE100"
                Data="M12.5 12V13H12C11.4477 13 11 13.4477 11 14V18C11 18.5523 11.4477 19 12 19H17C17.5523 19 18 18.5523 18 18V14C18 13.4477 17.5523 13 17 13H16.5V12C16.5 10.8954 15.6046 10 14.5 10C13.3954 10 12.5 10.8954 12.5 12ZM13.5 13V12C13.5 11.4477 13.9477 11 14.5 11C15.0523 11 15.5 11.4477 15.5 12V13H13.5ZM14.5 15.25C14.9142 15.25 15.25 15.5858 15.25 16C15.25 16.4142 14.9142 16.75 14.5 16.75C14.0858 16.75 13.75 16.4142 13.75 16C13.75 15.5858 14.0858 15.25 14.5 15.25Z"
                Stretch="None"
                Style="{StaticResource IconCautionPathStyle}" />
        </Grid>
    </Viewbox>
</controls:ScaledPathIcon>
