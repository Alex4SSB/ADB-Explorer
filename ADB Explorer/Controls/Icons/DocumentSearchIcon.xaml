                d:Fill="#4CC2FF"
                Data="M5.5 17C6.2862 17 7.01185 16.7408 7.59615 16.3031L10.1464 18.8535C10.3417 19.0488 10.6583 19.0488 10.8535 18.8535C11.0488 18.6583 11.0488 18.3417 10.8536 18.1464L8.30324 15.596C8.74082 15.0117 9 14.2861 9 13.5C9 11.567 7.433 10 5.5 10C3.567 10 2 11.567 2 13.5C2 15.433 3.567 17 5.5 17ZM5.5 16C4.11929 16 3 14.8807 3 13.5C3 12.1193 4.11929 11 5.5 11C6.88071 11 8 12.1193 8 13.5C8 14.8807 6.88071 16 5.5 16Z"
