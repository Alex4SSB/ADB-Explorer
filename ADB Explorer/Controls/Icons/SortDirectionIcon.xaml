<UserControl
    x:Class="ADB_Explorer.Controls.SortDirectionIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:ADB_Explorer.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="sortDirectionIcon"
    mc:Ignorable="d">
    <Viewbox StretchDirection="DownOnly">
        <Grid DataContext="{Binding ElementName=sortDirectionIcon}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ui:FontIcon
                d:FontSize="14"
                d:FontWeight="Bold"
                d:Foreground="#4CC2FF"
                Glyph="&#xE7EB;">
                <ui:FontIcon.Style>
                    <Style BasedOn="{StaticResource GlyphFont}" TargetType="ui:FontIcon">
                        <Setter Property="FontSize" Value="10" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Direction}" Value="Ascending">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource IconAccentBrush}" />
                                <Setter Property="FontSize" Value="14" />
                            </DataTrigger>
                            <!--  IconAccentBrush above is a Style Setter with no hover awareness of its own — same IsMenuHighlighted flip as IconAccentGlyphStyle, so the active-direction arrow still reacts to hovering the menu item.  -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsHighContrast}" Value="True" />
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(helpers:StyleHelper.IsMenuHighlighted)}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource MouseOverForeground}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:FontIcon.Style>
            </ui:FontIcon>
            <ui:FontIcon
                Grid.Column="1"
                Margin="-4,0,0,0"
                d:FontSize="10"
                Glyph="&#xE7EB;"
                RenderTransformOrigin="0.5,0.5">
                <ui:FontIcon.RenderTransform>
                    <RotateTransform Angle="180" />
                </ui:FontIcon.RenderTransform>
                <ui:FontIcon.Style>
                    <Style BasedOn="{StaticResource GlyphFont}" TargetType="ui:FontIcon">
                        <Setter Property="FontSize" Value="10" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Direction}" Value="Descending">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{DynamicResource IconAccentBrush}" />
                                <Setter Property="FontSize" Value="14" />
                            </DataTrigger>
                            <!--  Same hover flip as the ascending arrow above — see its comment.  -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsHighContrast}" Value="True" />
                                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(helpers:StyleHelper.IsMenuHighlighted)}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource MouseOverForeground}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:FontIcon.Style>
            </ui:FontIcon>
        </Grid>
    </Viewbox>
</UserControl>
