<UserControl
    x:Class="ADB_Explorer.Controls.PaneStatus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ADB_Explorer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource MarginedTextBlockStyle}" TargetType="TextBlock" />
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Visibility="{Binding ContainerVisibility}">
        <StackPanel Orientation="Horizontal" Visibility="{Binding ItemsVisibility}">
            <TextBlock Text="{Binding ItemsCount}" />
            <TextBlock Text=" " />
            <TextBlock Margin="0,4" Text="{Binding ItemsSuffix}" />
            <TextBlock Style="{StaticResource UnfinishedTextblockStyle}" Text=" *" Visibility="{Binding UnfinishedVisibility}" />
        </StackPanel>
        <Separator Style="{StaticResource StatusBarSeparatorStyle}" Visibility="{Binding SelectedVisibility}" />
        <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedVisibility}">
            <TextBlock Text="{Binding SelectedCount}" />
            <TextBlock Text=" " />
            <TextBlock Text="{Binding SelectedSuffix}" />
            <TextBlock
                Margin="6,4,0,4"
                Text="{Binding SelectedTotalSize}"
                Visibility="{Binding SelectedTotalSizeVisibility}" />
        </StackPanel>
        <local:PasteAndPullTooltip x:Name="PasteTooltip" Margin="10,0" />
    </StackPanel>
</UserControl>
