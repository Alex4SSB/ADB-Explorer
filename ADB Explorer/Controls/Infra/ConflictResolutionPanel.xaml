<UserControl
    x:Class="ADB_Explorer.Controls.ConflictResolutionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ADB_Explorer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Root"
    d:DesignWidth="440"
    IsTabStop="False"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="ConflictOptionStyle"
            BasedOn="{StaticResource AdbCardActionStyle}"
            TargetType="ui:CardAction">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="ConflictOptionIconStyle"
            BasedOn="{StaticResource GlyphFont}"
            TargetType="ui:FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ConflictOptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <local:SimpleStackPanel DataContext="{Binding ElementName=Root}" Spacing="4">
        <TextBlock
            Margin="0,0,0,12"
            FontSize="14"
            Text="{Binding Message}"
            TextWrapping="Wrap" />

        <ui:CardAction Click="Replace_Click" Style="{StaticResource ConflictOptionStyle}">
            <ui:CardAction.Icon>
                <ui:FontIcon
                    FontWeight="Bold"
                    Foreground="#0F7B0F"
                    Glyph="&#xE73E;"
                    Style="{StaticResource ConflictOptionIconStyle}" />
            </ui:CardAction.Icon>
            <TextBlock Style="{StaticResource ConflictOptionTextStyle}" Text="{Binding ReplaceText}" />
        </ui:CardAction>

        <ui:CardAction Click="Skip_Click" Style="{StaticResource ConflictOptionStyle}">
            <ui:CardAction.Icon>
                <ui:FontIcon
                    Foreground="#0078D4"
                    Glyph="&#xE7A7;"
                    Style="{StaticResource ConflictOptionIconStyle}" />
            </ui:CardAction.Icon>
            <TextBlock Style="{StaticResource ConflictOptionTextStyle}" Text="{Binding SkipText}" />
        </ui:CardAction>

        <ui:CardAction Click="Decide_Click" Style="{StaticResource ConflictOptionStyle}">
            <DockPanel>
                <local:DocumentMultipleIcon
                    Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Size="20" />
                <TextBlock Style="{StaticResource ConflictOptionTextStyle}" Text="{Binding DecideText}" />
            </DockPanel>
        </ui:CardAction>
    </local:SimpleStackPanel>
</UserControl>
