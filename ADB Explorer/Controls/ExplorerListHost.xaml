<UserControl
    x:Class="ADB_Explorer.Controls.ExplorerListHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ADB_Explorer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
    xmlns:helpers="clr-namespace:ADB_Explorer.Helpers"
    xmlns:local="clr-namespace:ADB_Explorer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:pages="clr-namespace:ADB_Explorer.ViewModels.Pages"
    xmlns:strings="clr-namespace:ADB_Explorer.Strings"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:ADB_Explorer.Views"
    d:DataContext="{d:DesignInstance Type=pages:ExplorerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <sys:Int16 x:Key="FontSize">13</sys:Int16>
        <local:AdbContextMenu x:Key="RowContextMenu" Style="{StaticResource ExplorerContextMenuStyle}" />
        <converters:ColumnSortDirectionConverter x:Key="ColumnSortDirectionConverter" />
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <Style
            x:Key="DataGridCellStyle"
            BasedOn="{StaticResource BaseCellStyle}"
            TargetType="{x:Type DataGridCell}">
            <EventSetter Event="RequestBringIntoView" Handler="DataGridCell_RequestBringIntoView" />
            <EventSetter Event="PreviewMouseDown" Handler="DataGridCell_PreviewMouseDown" />
            <EventSetter Event="MouseUp" Handler="DataGridCell_MouseUp" />
        </Style>
        <Style
            x:Key="RowStyle"
            BasedOn="{StaticResource BaseRowStyle}"
            TargetType="DataGridRow">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
            <EventSetter Event="MouseDown" Handler="DataGridRow_MouseDown" />
            <EventSetter Event="MouseDoubleClick" Handler="ItemContainer_MouseDoubleClick" />
            <EventSetter Event="KeyDown" Handler="DataGridRow_KeyDown" />
            <EventSetter Event="Drop" Handler="DataGridRow_Drop" />
            <EventSetter Event="MouseUp" Handler="DataGridCell_MouseUp" />
            <EventSetter Event="DragOver" Handler="ExplorerGrid_DragOver" />
            <EventSetter Event="PreviewDragEnter" Handler="Row_PreviewDragEnter" />
            <EventSetter Event="PreviewDragLeave" Handler="Row_PreviewDragLeave" />
            <EventSetter Event="MouseLeave" Handler="Row_MouseLeave" />
        </Style>
        <DataTemplate x:Key="LogicalDriveTemplate">
            <views:LogicalDriveControl />
        </DataTemplate>
        <DataTemplate x:Key="VirtualDriveTemplate">
            <views:VirtualDriveControl />
        </DataTemplate>
        <helpers:DriveTemplateSelector
            x:Key="DriveTemplateSelector"
            LogicalDriveTemplate="{StaticResource LogicalDriveTemplate}"
            VirtualDriveTemplate="{StaticResource VirtualDriveTemplate}" />
        <Style
            x:Key="DriveListViewStyle"
            BasedOn="{StaticResource ListViewStyle}"
            TargetType="ui:ListView">
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ItemTemplateSelector" Value="{StaticResource DriveTemplateSelector}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DriveContainerStyle}" />
        </Style>
        <Style
            x:Key="IconFileContainerWithContextMenuStyle"
            BasedOn="{StaticResource IconFileContainerStyle}"
            TargetType="ui:ListViewItem">
            <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
            <EventSetter Event="MouseDoubleClick" Handler="ItemContainer_MouseDoubleClick" />
            <EventSetter Event="PreviewDragEnter" Handler="Row_PreviewDragEnter" />
            <EventSetter Event="PreviewDragLeave" Handler="Row_PreviewDragLeave" />
            <EventSetter Event="MouseLeave" Handler="Row_MouseLeave" />
            <EventSetter Event="Drop" Handler="DataGridRow_Drop" />
            <EventSetter Event="DragOver" Handler="ExplorerGrid_DragOver" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.FileActions}, Path=IsAppDrive}" Value="False">
                    <Setter Property="AllowDrop" Value="{Binding IsDirectory}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.FileActions}, Path=IsAppDrive}" Value="True">
                    <Setter Property="AllowDrop" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer
            PreviewMouseDown="DriveList_PreviewMouseDown"
            RequestBringIntoView="DriveScrollViewer_RequestBringIntoView"
            Style="{StaticResource DriveViewScrollViewerStyle}">
            <StackPanel>
                <Expander
                    Margin="4"
                    helpers:ExpanderHelper.ChevronPlacement="Left"
                    helpers:ExpanderHelper.IsTransparent="True">
                    <Expander.Style>
                        <Style BasedOn="{StaticResource AdbExpanderStyle}" TargetType="Expander">
                            <Setter Property="IsExpanded" Value="{Binding Source={x:Static Member=models:Data.Settings}, Path=HomeLocationsExpanded, Mode=TwoWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SavedItems.Count}" Value="0">
                                    <Setter Property="IsExpanded" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Expander.Style>
                    <Expander.Header>
                        <local:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                            <ui:FontIcon FontSize="18" Glyph="&#xE734;" />
                            <TextBlock Text="{Binding Source={x:Static Member=strings:Resources.S_SAVED_LOCATIONS}}" />
                        </local:SimpleStackPanel>
                    </Expander.Header>
                    <ui:ListView
                        x:Name="HomeSavedLocationsList"
                        ItemsSource="{Binding SavedItems}"
                        Style="{StaticResource HomeSavedLocationsListStyle}">
                        <ui:ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Width="{Binding RelativeSource={RelativeSource AncestorType=ui:ListView}, Path=ActualWidth}" />
                            </ItemsPanelTemplate>
                        </ui:ListView.ItemsPanel>
                    </ui:ListView>
                </Expander>
                <Expander
                    Margin="4"
                    helpers:ExpanderHelper.ChevronPlacement="Left"
                    helpers:ExpanderHelper.IsTransparent="True"
                    IsExpanded="True"
                    Style="{StaticResource AdbExpanderStyle}">
                    <Expander.Header>
                        <local:SimpleStackPanel Orientation="Horizontal" Spacing="10">
                            <ui:FontIcon
                                Margin="0,1,0,0"
                                FontSize="18"
                                Glyph="&#xE8CE;" />
                            <TextBlock Text="{Binding Source={x:Static Member=strings:Resources.S_BUTTON_DRIVES}}" />
                        </local:SimpleStackPanel>
                    </Expander.Header>
                    <ui:ListView
                        x:Name="DriveList"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding DriveItemsSource}"
                        PreviewMouseDown="DriveList_PreviewMouseDown"
                        Style="{StaticResource DriveListViewStyle}">
                        <ui:ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Width="{Binding RelativeSource={RelativeSource AncestorType=ui:ListView}, Path=ActualWidth}" />
                            </ItemsPanelTemplate>
                        </ui:ListView.ItemsPanel>
                    </ui:ListView>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <local:AdbListView
            x:Name="IconView"
            HorizontalAlignment="Stretch"
            ContextMenu="{StaticResource RowContextMenu}"
            ContextMenuClosing="ExplorerGrid_ContextMenuClosing"
            ContextMenuOpening="ExplorerGrid_ContextMenuOpening"
            DragOver="ExplorerGrid_DragOver"
            Drop="DataGridRow_Drop"
            ItemsSource="{Binding ExplorerItemsSource}"
            MouseMove="IconView_MouseMove"
            PreviewMouseDown="IconView_PreviewMouseDown"
            PreviewMouseUp="IconView_PreviewMouseUp"
            ScrollViewer.ScrollChanged="ExplorerScrollViewer_ScrollChanged"
            SelectionChanged="ExplorerGrid_SelectionChanged">
            <local:AdbListView.Resources>
                <DataTemplate x:Key="FileIconViewTemplate">
                    <views:FileIconView />
                </DataTemplate>
            </local:AdbListView.Resources>
            <local:AdbListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:AdbVirtualizingWrapPanel
                        CacheLength="2,2"
                        CacheLengthUnit="Page"
                        IsVirtualizing="True"
                        VirtualizationMode="Recycling" />
                </ItemsPanelTemplate>
            </local:AdbListView.ItemsPanel>
            <local:AdbListView.Style>
                <Style BasedOn="{StaticResource ListViewStyle}" TargetType="local:AdbListView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIconView}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.FileActions}, Path=IsDriveViewVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.FileActions}, Path=IsRecycleBin}" Value="False">
                            <Setter Property="AllowDrop" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="SnapsToDevicePixels" Value="False" />
                    <Setter Property="SelectionMode" Value="Extended" />
                    <Setter Property="IsItemScrolling" Value="True" />
                    <Setter Property="ItemContainerStyle" Value="{StaticResource IconFileContainerWithContextMenuStyle}" />
                    <Setter Property="ItemTemplate" Value="{StaticResource FileIconViewTemplate}" />
                </Style>
            </local:AdbListView.Style>
        </local:AdbListView>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIconView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsContentView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ui:DataGrid
                x:Name="ExplorerGrid"
                AutoGenerateColumns="False"
                Background="Transparent"
                CanUserResizeRows="False"
                CellStyle="{StaticResource DataGridCellStyle}"
                ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                ContextMenu="{StaticResource RowContextMenu}"
                ContextMenuClosing="ExplorerGrid_ContextMenuClosing"
                ContextMenuOpening="ExplorerGrid_ContextMenuOpening"
                DragOver="ExplorerGrid_DragOver"
                Drop="DataGridRow_Drop"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ItemsSource="{Binding ExplorerItemsSource}"
                KeyboardNavigation.TabNavigation="Once"
                MouseDown="ExplorerGrid_MouseDown"
                MouseMove="ExplorerGrid_MouseMove"
                RowStyle="{StaticResource RowStyle}"
                ScrollViewer.ScrollChanged="ExplorerScrollViewer_ScrollChanged"
                SelectionChanged="ExplorerGrid_SelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Sorting="ExplorerGrid_Sorting"
                Style="{StaticResource ExplorerGridStyle}">
                <ui:DataGrid.Columns>
                    <DataGridTemplateColumn
                        x:Name="IconColumn"
                        MaxWidth="30"
                        CanUserResize="False"
                        CellTemplate="{StaticResource FileIconTemplate}"
                        IsReadOnly="True"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.FolderColumnVisibility}">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style BasedOn="{StaticResource DataGridColumnHeaderStyle}" TargetType="DataGridColumnHeader">
                                <Setter Property="ToolTip" Value="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_ICON}}" />
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        x:Name="NameColumn"
                        Width="300"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_NAME}}"
                        IsReadOnly="True"
                        SortMemberPath="FullName"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.FolderColumnVisibility}">
                        <DataGridTemplateColumn.SortDirection>
                            <MultiBinding Converter="{StaticResource ColumnSortDirectionConverter}" ConverterParameter="Name">
                                <Binding Path="Data.SortDirection" Source="{StaticResource ViewModelProxy}" />
                                <Binding Path="Data.SortedColumn" Source="{StaticResource ViewModelProxy}" />
                            </MultiBinding>
                        </DataGridTemplateColumn.SortDirection>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ui:TextBox
                                        FlowDirection="{Binding NameFlowDirection}"
                                        IsVisibleChanged="NameColumnEdit_IsVisibleChanged"
                                        KeyDown="NameColumnEdit_KeyDown"
                                        LostFocus="NameColumnEdit_LostFocus"
                                        TextChanged="NameColumnEdit_TextChanged">
                                        <ui:TextBox.Style>
                                            <Style BasedOn="{StaticResource FileNameEditingElementStyle}" TargetType="ui:TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FolderViewModel.IsInEditMode}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBox.Style>
                                    </ui:TextBox>
                                    <emoji:TextBlock FlowDirection="{Binding NameFlowDirection}" Text="{Binding DisplayName}">
                                        <emoji:TextBlock.Style>
                                            <Style BasedOn="{StaticResource DirectoryGridCellStyle}" TargetType="TextBlock">
                                                <Setter Property="Margin" Value="4,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FolderViewModel.IsInEditMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </emoji:TextBlock.Style>
                                    </emoji:TextBlock>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        x:Name="OriginalPath"
                        Width="180"
                        Binding="{Binding TrashIndex.ParentPath}"
                        FontSize="{Binding Source={StaticResource FontSize}}"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_ORIGINAL_LOCATION}}"
                        IsReadOnly="True"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.RecycleBinColumnVisibility}">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource DirectoryGridCellStyle}" TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,0" />
                                <Setter Property="FlowDirection" Value="LeftToRight" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        x:Name="DateColumn"
                        Width="Auto"
                        FontSize="{Binding Source={StaticResource FontSize}}"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_DATE_MODIFIED}}"
                        IsReadOnly="True"
                        SortMemberPath="ModifiedTime"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.FolderColumnVisibility}">
                        <DataGridTextColumn.SortDirection>
                            <MultiBinding Converter="{StaticResource ColumnSortDirectionConverter}" ConverterParameter="Date">
                                <Binding Path="Data.SortDirection" Source="{StaticResource ViewModelProxy}" />
                                <Binding Path="Data.SortedColumn" Source="{StaticResource ViewModelProxy}" />
                            </MultiBinding>
                        </DataGridTextColumn.SortDirection>
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource DirectoryGridCellStyle}" TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Text" Value="{Binding FolderViewModel.ModifiedTimeString}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="File">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Folder">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="BrokenLink">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn
                        x:Name="TypeColumn"
                        Width="150"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_TYPE}}"
                        IsReadOnly="True"
                        SortMemberPath="FolderViewModel.TypeName"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.FolderColumnVisibility}">
                        <DataGridTemplateColumn.SortDirection>
                            <MultiBinding Converter="{StaticResource ColumnSortDirectionConverter}" ConverterParameter="Type">
                                <Binding Path="Data.SortDirection" Source="{StaticResource ViewModelProxy}" />
                                <Binding Path="Data.SortedColumn" Source="{StaticResource ViewModelProxy}" />
                            </MultiBinding>
                        </DataGridTemplateColumn.SortDirection>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <emoji:TextBlock
                                    Margin="4,0"
                                    FlowDirection="{Binding FolderViewModel.TypeFlowDirection}"
                                    FontSize="{Binding Source={StaticResource FontSize}}"
                                    Style="{StaticResource DirectoryGridCellStyle}"
                                    Text="{Binding FolderViewModel.TypeName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        x:Name="SizeColumn"
                        Width="Auto"
                        FontSize="{Binding Source={StaticResource FontSize}}"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_SIZE}}"
                        IsReadOnly="True"
                        SortMemberPath="Size"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.FolderColumnVisibility}">
                        <DataGridTextColumn.SortDirection>
                            <MultiBinding Converter="{StaticResource ColumnSortDirectionConverter}" ConverterParameter="Size">
                                <Binding Path="Data.SortDirection" Source="{StaticResource ViewModelProxy}" />
                                <Binding Path="Data.SortedColumn" Source="{StaticResource ViewModelProxy}" />
                            </MultiBinding>
                        </DataGridTextColumn.SortDirection>
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource DirectoryGridCellStyle}" TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,0" />
                                <Setter Property="Text" Value="{Binding FolderViewModel.SizeString}" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <Trigger Property="FlowDirection" Value="RightToLeft">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Type}" Value="File" />
                                            <Condition Binding="{Binding IsLink}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        x:Name="OriginalDate"
                        Width="Auto"
                        Binding="{Binding TrashIndex.ModifiedTimeString}"
                        FontSize="{Binding Source={StaticResource FontSize}}"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_DATE_DELETED}}"
                        IsReadOnly="True"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.RecycleBinColumnVisibility}">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource DirectoryGridCellStyle}" TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        x:Name="PackageName"
                        Width="400"
                        Binding="{Binding DisplayName}"
                        FontSize="{Binding Source={StaticResource FontSize}}"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_NAME}}"
                        IsReadOnly="True"
                        SortMemberPath="DisplayName"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.PackageColumnVisibility}">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource ExplorerGridCellStyle}" TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        x:Name="PackageType"
                        Width="100"
                        Binding="{Binding Type}"
                        FontSize="{Binding Source={StaticResource FontSize}}"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_TYPE}}"
                        IsReadOnly="True"
                        SortDirection="{Binding Source={StaticResource ViewModelProxy}, Path=Data.PackageTypeColumnSortDirection}"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.PackageColumnVisibility}">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource ExplorerGridCellStyle}" TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        x:Name="PackageUid"
                        Width="100"
                        Binding="{Binding Uid}"
                        FontSize="{Binding Source={StaticResource FontSize}}"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_USER_ID}}"
                        IsReadOnly="True"
                        SortMemberPath="Uid"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.PackageColumnVisibility}">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource ExplorerGridCellStyle}" TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.SortDirection>
                            <MultiBinding Converter="{StaticResource ColumnSortDirectionConverter}" ConverterParameter="UserId">
                                <Binding Path="Data.SortDirection" Source="{StaticResource ViewModelProxy}" />
                                <Binding Path="Data.SortedColumn" Source="{StaticResource ViewModelProxy}" />
                            </MultiBinding>
                        </DataGridTextColumn.SortDirection>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        x:Name="PackageVersion"
                        Width="100"
                        Binding="{Binding Version}"
                        FontSize="{Binding Source={StaticResource FontSize}}"
                        Header="{Binding Source={x:Static Member=strings:Resources.S_COLUMN_VERSION}}"
                        IsReadOnly="True"
                        SortMemberPath="Version"
                        Visibility="{Binding Source={StaticResource ViewModelProxy}, Path=Data.PackageColumnVisibility}">
                        <DataGridTextColumn.ElementStyle>
                            <Style BasedOn="{StaticResource ExplorerGridCellStyle}" TargetType="TextBlock">
                                <Setter Property="Margin" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.SortDirection>
                            <MultiBinding Converter="{StaticResource ColumnSortDirectionConverter}" ConverterParameter="Version">
                                <Binding Path="Data.SortDirection" Source="{StaticResource ViewModelProxy}" />
                                <Binding Path="Data.SortedColumn" Source="{StaticResource ViewModelProxy}" />
                            </MultiBinding>
                        </DataGridTextColumn.SortDirection>
                    </DataGridTextColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsContentView}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ui:DataGrid
                x:Name="ContentGrid"
                AlternationCount="2147483647"
                AutoGenerateColumns="False"
                Background="Transparent"
                CanUserResizeColumns="False"
                CanUserResizeRows="False"
                CanUserSortColumns="False"
                CellStyle="{StaticResource DataGridCellStyle}"
                ContextMenu="{StaticResource RowContextMenu}"
                ContextMenuClosing="ExplorerGrid_ContextMenuClosing"
                ContextMenuOpening="ExplorerGrid_ContextMenuOpening"
                DragOver="ExplorerGrid_DragOver"
                Drop="DataGridRow_Drop"
                GridLinesVisibility="None"
                HeadersVisibility="None"
                IsReadOnly="False"
                ItemsSource="{Binding ExplorerItemsSource}"
                KeyboardNavigation.TabNavigation="Once"
                MouseDown="ContentGrid_MouseDown"
                MouseMove="ExplorerGrid_MouseMove"
                RowStyle="{StaticResource ContentRowStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.ScrollChanged="ExplorerScrollViewer_ScrollChanged"
                SelectionChanged="ExplorerGrid_SelectionChanged"
                SelectionMode="Extended"
                SelectionUnit="FullRow"
                Style="{StaticResource ExplorerGridStyle}">
                <ui:DataGrid.Columns>
                    <!--
                        Content view as three real columns (Name, Type, Date/Size). Only name/path
                        is star-sized - it is the sole column that grows or shrinks with the
                        window, capped by MaxWidth so it doesn't push Type and Date/Size out to the
                        far right of a very wide window, but otherwise free to grow well past what
                        the classic grid's fixed columns allow, so it isn't trimmed just because the
                        window happens to be maximized. Type and Date/Size are NOT star columns -
                        each is a fixed width (see their own comments, and ContentGrid_SizeChanged
                        in the code-behind, for how each one's width and visibility are driven from
                        this grid's own ActualWidth - a DataGridColumn isn't part of the visual
                        tree, so its own Width/Visibility can't react to that via a
                        RelativeSource/ElementName binding the way each cell template's content
                        can). Because they're fixed rather than sharing a star-width pool with
                        name/path, they never get squeezed to an in-between size that's too narrow
                        for their full text but not yet hidden. name/path is allowed to give up
                        some of its own comfortable width first, but Type and then Date/Size give
                        way - outright, never trimmed into an unreadable fragment - well before
                        name/path would otherwise be squeezed all the way down to its bare
                        MinWidth. Below its own narrowest threshold, Date/Size collapses entirely
                        just like Type; above that but below a wider one, it keeps showing "Size:
                        {...}" alone, with "Date modified: {...}" hidden (never trimmed) rather
                        than collapsed outright, so "Size: {...}" stays anchored to the same
                        position it holds when both lines are shown instead of hopping into the
                        space the date line leaves behind.
                    -->
                    <DataGridTemplateColumn
                        x:Name="ContentNameColumn"
                        Width="*"
                        MinWidth="150"
                        MaxWidth="550"
                        CanUserResize="False"
                        IsReadOnly="True"
                        SortMemberPath="FullName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--
                                    The item divider used to be this Border's own bottom edge, which sat
                                    inside the row's selection/hover highlight (RowBorder in
                                    ContentDataGridRowTemplate) and so looked like part of the item. It is
                                    now drawn by that row template instead, in the gap between rows -
                                    outside the highlighted/rounded area - so it reads as a divider between
                                    items rather than a stroke on the item itself.
                                -->
                                <Border Padding="10,7,0,7">
                                    <DockPanel LastChildFill="True">

                                        <!--  32px icon / thumbnail  -->
                                        <Image
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Left"
                                            Source="{Binding IconViewModel.LargeIcon}"
                                            Stretch="Uniform" />

                                        <!--  Row 0: file name / Row 1: full path — fills the rest of this column  -->
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <ui:TextBox
                                                    FlowDirection="{Binding NameFlowDirection}"
                                                    IsVisibleChanged="NameColumnEdit_IsVisibleChanged"
                                                    KeyDown="NameColumnEdit_KeyDown"
                                                    LostFocus="NameColumnEdit_LostFocus"
                                                    TextChanged="NameColumnEdit_TextChanged">
                                                    <ui:TextBox.Style>
                                                        <Style BasedOn="{StaticResource FileNameEditingElementStyle}" TargetType="ui:TextBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FolderViewModel.IsInEditMode}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:TextBox.Style>
                                                </ui:TextBox>
                                                <emoji:TextBlock
                                                    x:Name="ContentNameText"
                                                    FlowDirection="{Binding NameFlowDirection}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis">
                                                    <emoji:TextBlock.Style>
                                                        <Style BasedOn="{StaticResource DirectoryGridCellStyle}" TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FolderViewModel.IsInEditMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </emoji:TextBlock.Style>
                                                </emoji:TextBlock>
                                            </Grid>
                                            <emoji:TextBlock
                                                Grid.Row="1"
                                                Margin="0,2,0,0"
                                                FontSize="{Binding Source={StaticResource FontSize}}"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding FullPath}"
                                                TextTrimming="CharacterEllipsis">
                                                <emoji:TextBlock.Style>
                                                    <Style BasedOn="{StaticResource DirectoryGridCellStyle}" TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </emoji:TextBlock.Style>
                                            </emoji:TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        x:Name="ContentTypeColumn"
                        Width="Auto"
                        CanUserResize="False"
                        IsReadOnly="True"
                        SortMemberPath="FolderViewModel.TypeName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--
                                    Auto-width: this column always sizes to its own full "Type: {...}" text
                                    (never trimmed) rather than sharing a star-width pool with the other
                                    columns, so it's never rendered at some in-between width that's too
                                    narrow to show that text but not yet hidden. Below
                                    ContentTypeColumnHideWidth, ContentGrid_SizeChanged in the code-behind
                                    collapses the whole column outright (not just this Border's content) so
                                    name/path reclaims the freed space instead of leaving a blank gap where
                                    Type used to be.
                                -->
                                <Border Padding="14,7,0,7">
                                    <emoji:TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{Binding Source={StaticResource FontSize}}"
                                        Text="{Binding FolderViewModel.ContentViewTypeText}">
                                        <emoji:TextBlock.Style>
                                            <Style BasedOn="{StaticResource DirectoryGridCellStyle}" TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </emoji:TextBlock.Style>
                                    </emoji:TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        x:Name="ContentDateSizeColumn"
                        Width="250"
                        CanUserResize="False"
                        IsReadOnly="True"
                        SortMemberPath="ModifiedTime">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="14,7,10,7">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!--
                                            This column's own declared Width is fixed, not star - either
                                            ContentDateSizeFullWidth (250) or, below ContentDateLineHideWidth,
                                            ContentDateSizeCollapsedWidth (130) - and its own Visibility
                                            collapses the whole column entirely below the narrower
                                            ContentDateSizeColumnHideWidth, all set directly by
                                            ContentGrid_SizeChanged in the code-behind (see its comment for
                                            why a DataGridColumn's own Width/Visibility can't just be bound to
                                            this grid's ActualWidth from here). "Date modified: {...}" - the
                                            longer of this column's two lines - hides (never trimmed) in
                                            lockstep with that same Width step, via
                                            ExplorerListHost.ContentDateLineVisibility (see that property's own
                                            comment for why this binds to it directly, via RelativeSource to
                                            this UserControl itself, rather than reacting to this cell's own
                                            ActualWidth the way ContentTypeColumn's cell template used to).
                                        -->
                                        <emoji:TextBlock
                                            Grid.Row="0"
                                            FontSize="{Binding Source={StaticResource FontSize}}"
                                            Text="{Binding FolderViewModel.ContentViewModifiedTimeText}"
                                            Visibility="{Binding ContentDateLineVisibility, RelativeSource={RelativeSource AncestorType=local:ExplorerListHost}}">
                                            <emoji:TextBlock.Style>
                                                <Style BasedOn="{StaticResource DirectoryGridCellStyle}" TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SelectedForeground}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </emoji:TextBlock.Style>
                                        </emoji:TextBlock>
                                        <emoji:TextBlock
                                            Grid.Row="1"
                                            Margin="0,2,0,0"
                                            FontSize="{Binding Source={StaticResource FontSize}}"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding FolderViewModel.ContentViewSizeText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </Grid>
        <local:SelectionRectangle
            x:Name="SelectionRect"
            PreviewMouseUp="SelectionRect_PreviewMouseUp"
            RectMouseMove="SelectionRect_MouseMove" />
        <Grid Margin="0,40" Style="{StaticResource EmptyFolderGridStyle}">
            <StackPanel Style="{StaticResource NonRootEmptyFolderStyle}">
                <TextBlock
                    helpers:TextHelper.AltText="{Binding Source={x:Static Member=strings:Resources.S_NON_ROOT_EMPTY_FOLDER}}"
                    Loaded="EmptyNonRootTextBlock_Loaded"
                    TextAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource EmptyFolderAltPromptStyle}" />
        </Grid>
    </Grid>
</UserControl>
