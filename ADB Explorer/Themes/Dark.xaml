<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="NoticeBorderBackground" Color="#FF433519" />
    <SolidColorBrush x:Key="SeparatorForeground" Color="#FF808080" />
    <SolidColorBrush x:Key="NewDeviceAltBorder" Color="#FF228B22" />
    <SolidColorBrush x:Key="TempDriveAltBorder" Color="#FFA349A4" />
    <SolidColorBrush x:Key="TrashDriveAltBorder" Color="#FFFF4500" />
    <SolidColorBrush x:Key="HistoryDeviceBottomBorderBrush" Color="#FFABA673" />
    <SolidColorBrush x:Key="FileOpHyperLinkBrush" Color="#FF66B3FF" />
    <SolidColorBrush x:Key="HyperLinkBrush" Color="#FF90C4F9" />
    <SolidColorBrush x:Key="SponsorIconBrush" Color="#FFDB61A2" />
    <SolidColorBrush x:Key="RootTitleBrush" Color="#FFA82E00" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="{DynamicResource TextFillColorPrimary}" />

    <SolidColorBrush x:Key="MouseOverBackground" Color="#5F4D4D4D" />
    <SolidColorBrush x:Key="MouseOverForeground" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="SelectedBackground" Color="#7F777777" />
    <SolidColorBrush x:Key="SelectedForeground" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="SelectedInactiveBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="SelectedMouseOverInactiveBackground" Color="#BF777777" />
    <SolidColorBrush x:Key="DeviceMouseOverBackground" Color="#FF4D4D4D" />

    <SolidColorBrush x:Key="SelectedMouseOverBackground" Color="#7F777777" />

    <SolidColorBrush x:Key="SelectedMouseOverForeground" Color="{DynamicResource TextFillColorPrimary}" />

    <SolidColorBrush x:Key="MouseOverBorderBrush" Color="Transparent" />

    <SolidColorBrush x:Key="SelectedMouseOverBorderBrush" Color="{DynamicResource TextFillColorPrimary}" />

    <SolidColorBrush x:Key="OpaqueBorderBrush" Color="#10FFFFFF" />

    <SolidColorBrush x:Key="IconAccentBrush" Color="{DynamicResource AccentFillColorDefault}" />
</ResourceDictionary>