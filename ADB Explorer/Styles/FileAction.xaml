<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ADB_Explorer.Controls"
    xmlns:converters="clr-namespace:ADB_Explorer.Converters"
    xmlns:helpers="clr-namespace:ADB_Explorer.Helpers"
    xmlns:models="clr-namespace:ADB_Explorer.Models"
    xmlns:viewmodels="clr-namespace:ADB_Explorer.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <converters:MenuItemConverter x:Key="MenuItemConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style
        x:Key="MenuIconStyle"
        BasedOn="{StaticResource DisabledGlyphStyle}"
        TargetType="ui:FontIcon">
        <Setter Property="FontSize" Value="{Binding IconSize}" />
    </Style>
    <Style
        x:Key="MenuSelectionBarStyle"
        BasedOn="{StaticResource MenuIconStyle}"
        TargetType="ui:FontIcon">
        <Setter Property="Glyph" Value="&#xE73C;" />
        <Setter Property="Margin" Value="0,0,0,-16" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelectionBarVisible}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="InvisibleTextBlockStyle"
        BasedOn="{StaticResource DisabledTextBlockStyle}"
        TargetType="TextBlock">
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="IconMenuTemplate">
        <Grid>
            <ContentPresenter Content="{Binding IconContent}" />
            <ui:FontIcon Style="{StaticResource MenuSelectionBarStyle}" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DynamicAltTextTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding IconContent}" />
            <TextBlock
                Grid.Column="1"
                Height="{Binding IconSize}"
                Margin="6,0,0,0"
                Style="{StaticResource InvisibleTextBlockStyle}"
                Text="{Binding AltText}" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="MenuSeparatorTemplate">
        <Border
            Width="1"
            Margin="0,4,-1,4"
            VerticalAlignment="Stretch"
            BorderBrush="{DynamicResource MenuBarItemBorderBrush}"
            BorderThickness="1,0,0,0" />
    </DataTemplate>
    <DataTemplate x:Key="CompoundIconMenuTemplate">
        <controls:SimpleStackPanel Orientation="Horizontal" Spacing="6">
            <ContentPresenter Content="{Binding IconContent}" />
            <TextBlock
                Grid.Column="1"
                Height="{Binding IconSize}"
                Margin="0,0,0,4"
                Text="{Binding Tooltip}"
                Visibility="{Binding IsNameDisplayed, Converter={StaticResource BoolToVisibility}}" />
            <ui:FontIcon
                Margin="0,2,0,0"
                FontSize="8"
                Glyph="&#xE70D;"
                Visibility="{Binding IsChevronVisible, Converter={StaticResource BoolToVisibility}}" />
        </controls:SimpleStackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DualActionButtonTemplate">
        <ContentPresenter Content="{Binding IconContent}" />
    </DataTemplate>
    <DataTemplate x:Key="SubMenuTemplate">
        <TextBlock Text="{Binding}" TextOptions.TextFormattingMode="Display" />
    </DataTemplate>
    <DataTemplate x:Key="SubMenuSeparatorTemplate">
        <Separator Margin="5,3" Background="{DynamicResource SeparatorForeground}" />
    </DataTemplate>
    <helpers:MenuTemplateSelector
        x:Key="MenuTemplateSelector"
        CompoundIconMenuTemplate="{StaticResource CompoundIconMenuTemplate}"
        DualActionButtonTemplate="{StaticResource DualActionButtonTemplate}"
        DynamicAltTextTemplate="{StaticResource DynamicAltTextTemplate}"
        IconMenuTemplate="{StaticResource IconMenuTemplate}"
        SeparatorTemplate="{StaticResource MenuSeparatorTemplate}"
        SubMenuSeparatorTemplate="{StaticResource SubMenuSeparatorTemplate}"
        SubMenuTemplate="{StaticResource SubMenuTemplate}" />
    <Style
        x:Key="ActionMenuItemStyle"
        BasedOn="{StaticResource AdbMenuItemHoverStyle}"
        TargetType="controls:AdbMenuItem">
        <Setter Property="Command" Value="{Binding Action.Command.Command}" />
        <Setter Property="ItemsSource" Value="{Binding Children}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source={x:Static Member=models:Data.RuntimeSettings}, Path=IsRTL}" Value="True">
                <Setter Property="FlowDirection" Value="RightToLeft" />
            </DataTrigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource AdbMenuItemSubmenuHeaderTemplateKey}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="IconMenuStyle"
        BasedOn="{StaticResource ActionMenuItemStyle}"
        TargetType="controls:AdbMenuItem">
        <Setter Property="Padding" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource MenuItemConverter}, ConverterParameter=Padding}" />
        <Setter Property="Margin" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource MenuItemConverter}, ConverterParameter=Margin}" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
        <Setter Property="ToolTip.FlowDirection" Value="LeftToRight" />
        <Setter Property="helpers:StyleHelper.ContentAnimation" Value="{Binding Animation}" />
        <Setter Property="helpers:StyleHelper.AnimateOnClick" Value="{Binding AnimateOnClick}" />
        <Setter Property="helpers:StyleHelper.ActivateAnimation" Value="{Binding ActivateAnimation}" />
        <Setter Property="helpers:StyleHelper.MirrorContentInRTL" Value="{Binding MirrorInRTL}" />
    </Style>
    <Style
        x:Key="CompoundIconMenuStyle"
        BasedOn="{StaticResource IconMenuStyle}"
        TargetType="controls:AdbMenuItem">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNameDisplayed}" Value="True">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="DynamicAltTextStyle"
        BasedOn="{StaticResource IconMenuStyle}"
        TargetType="controls:AdbMenuItem">
        <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsTooltipVisible}" />
    </Style>
    <Style
        x:Key="MenuSeparatorStyle"
        BasedOn="{StaticResource WpfUiMenuItem}"
        TargetType="controls:AdbMenuItem">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Padding" Value="2,0" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:AdbMenuItem}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Stretch"
                                ContentSource="Header" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="SubMenuSeparatorStyle"
        BasedOn="{StaticResource WpfUiMenuItem}"
        TargetType="controls:AdbMenuItem">
        <Setter Property="IsEnabled" Value="False" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Separator Margin="0,1" Background="{DynamicResource SeparatorForeground}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <DataTrigger Binding="{Binding HideSeparator}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <ToolTip
        x:Key="SubMenuInfoTooltip"
        MaxWidth="400"
        Style="{StaticResource FluentTooltipStyle}">
        <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
    </ToolTip>
    <!--  Check mark of a selector menu's items: a dot for radio items, a tick for toggles.  -->
    <ui:FontIcon x:Key="MenuCheckIcon" x:Shared="False">
        <ui:FontIcon.Style>
            <Style BasedOn="{StaticResource GlyphFont}" TargetType="ui:FontIcon">
                <Setter Property="Glyph" Value="&#xF137;" />
                <Setter Property="FontSize" Value="6" />
                <Setter Property="Margin" Value="14,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked}" Value="False">
                        <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRadioButton}" Value="False">
                        <Setter Property="Glyph" Value="&#xE73E;" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Margin" Value="11,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ui:FontIcon.Style>
    </ui:FontIcon>
    <!--  Items of a selector menu (search options, view options): BasedOn AdbMenuItemStyle for the hover-aware SubmenuItem template.  -->
    <Style
        x:Key="SelectorMenuItemStyle"
        BasedOn="{StaticResource AdbMenuItemStyle}"
        TargetType="controls:AdbMenuItem">
        <Setter Property="Icon" Value="{StaticResource MenuCheckIcon}" />
        <Setter Property="Command" Value="{Binding Action.Command}" />
        <Setter Property="ToolTip" Value="{StaticResource SubMenuInfoTooltip}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Info}" Value="{x:Null}">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="SubMenuItemStyle"
        BasedOn="{StaticResource ActionMenuItemStyle}"
        TargetType="controls:AdbMenuItem">
        <Setter Property="Header" Value="{Binding Action.Description}" />
        <Setter Property="InputGestureText" Value="{Binding Action.GestureString}" />
        <Setter Property="Icon" Value="{Binding IconContent}" />
        <Setter Property="ToolTip" Value="{StaticResource SubMenuInfoTooltip}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Info}" Value="{x:Null}">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(helpers:StyleHelper.ShowInputGestures)}" Value="False">
                <Setter Property="InputGestureText" Value="" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="SelectorSubMenuHeaderTemplate">
        <controls:SimpleStackPanel Orientation="Horizontal" Spacing="8">
            <!--  A ContentControl, not a ContentPresenter: the latter re-points its own DataContext at its content, which would break the trigger's binding.  -->
            <ContentControl
                Content="{Binding IconContent}"
                Focusable="False"
                IsTabStop="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IconContent}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <TextBlock Text="{Binding Action.Description}" />
        </controls:SimpleStackPanel>
    </DataTemplate>
    <!--  Radio choice of a context menu's Sort / View submenu: the dot marks the current choice, and the item's own icon, if any, leads its text.  -->
    <Style
        x:Key="SelectorSubMenuItemStyle"
        BasedOn="{StaticResource SubMenuItemStyle}"
        TargetType="controls:AdbMenuItem">
        <Setter Property="Icon" Value="{StaticResource MenuCheckIcon}" />
        <Setter Property="Header" Value="{Binding}" />
        <Setter Property="HeaderTemplate" Value="{StaticResource SelectorSubMenuHeaderTemplate}" />
    </Style>
    <Style
        x:Key="DummySubMenuStyle"
        BasedOn="{StaticResource SubMenuItemStyle}"
        TargetType="controls:AdbMenuItem">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="DualActionButtonStyle"
        BasedOn="{StaticResource IconMenuStyle}"
        TargetType="controls:AdbMenuItem">
        <Setter Property="IsCheckable" Value="{Binding IsCheckable}" />
        <Setter Property="IsChecked" Value="{Binding IsChecked}" />
        <!--<Setter Property="helpers:MenuHelper.CheckBackground" Value="{Binding CheckBackground}" />-->
    </Style>
    <helpers:MenuStyleSelector
        x:Key="MenuStyleSelector"
        CompoundIconMenuStyle="{StaticResource CompoundIconMenuStyle}"
        DualActionButtonStyle="{StaticResource DualActionButtonStyle}"
        DummySubMenuStyle="{StaticResource DummySubMenuStyle}"
        DynamicAltTextStyle="{StaticResource DynamicAltTextStyle}"
        IconMenuStyle="{StaticResource IconMenuStyle}"
        SelectorSubMenuStyle="{StaticResource SelectorSubMenuItemStyle}"
        SeparatorStyle="{StaticResource MenuSeparatorStyle}"
        SubMenuSeparatorStyle="{StaticResource SubMenuSeparatorStyle}"
        SubMenuStyle="{StaticResource SubMenuItemStyle}" />
    <Style
        x:Key="AdbToolBarStyle"
        x:Shared="False"
        BasedOn="{StaticResource AdbMenuStyle}"
        TargetType="controls:AdbMenu">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemTemplateSelector" Value="{StaticResource MenuTemplateSelector}" />
        <Setter Property="ItemContainerStyleSelector" Value="{StaticResource MenuStyleSelector}" />
        <Setter Property="helpers:MenuHelper.ItemMargin" Value="0" />
        <Setter Property="helpers:MenuHelper.ItemPadding" Value="12,0" />
    </Style>
    <Style
        x:Key="MainToolBarStyle"
        BasedOn="{StaticResource AdbToolBarStyle}"
        TargetType="controls:AdbMenu">
        <!--  ItemsSource is set per tab in ExplorerPageContent's constructor, not here - see MainToolBar.Build's comment.  -->
        <Setter Property="Margin" Value="7,0,0,0" />
    </Style>
    <Style
        x:Key="NavigationToolBarStyle"
        BasedOn="{StaticResource AdbToolBarStyle}"
        TargetType="controls:AdbMenu">
        <!--  ItemsSource is set per tab in ExplorerPageContent's constructor, not here - see NavigationToolBar.Build's comment.  -->
        <Setter Property="Margin" Value="7,0,0,0" />
    </Style>
    <Style
        x:Key="BaseContextMenuStyle"
        BasedOn="{StaticResource UiContextMenu}"
        TargetType="controls:AdbContextMenu">
        <Setter Property="ItemTemplateSelector" Value="{StaticResource MenuTemplateSelector}" />
        <Setter Property="ItemContainerStyleSelector" Value="{StaticResource MenuStyleSelector}" />
        <Setter Property="helpers:StyleHelper.ShowInputGestures" Value="{Binding ShowInputGestures, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style
        x:Key="ExplorerContextMenuStyle"
        BasedOn="{StaticResource BaseContextMenuStyle}"
        TargetType="controls:AdbContextMenu">
        <Setter Property="ItemsSource" Value="{Binding Source={x:Static Member=viewmodels:ExplorerContextMenu.VisibleList}}" />
    </Style>
    <Style
        x:Key="TreeContextMenuStyle"
        BasedOn="{StaticResource ExplorerContextMenuStyle}"
        TargetType="controls:AdbContextMenu">
        <Setter Property="ShowInputGestures" Value="False" />
    </Style>
    <Style
        x:Key="DeviceContextMenuStyle"
        BasedOn="{StaticResource BaseContextMenuStyle}"
        TargetType="controls:AdbContextMenu">
        <Setter Property="ItemsSource" Value="{Binding Source={x:Static Member=viewmodels:DeviceContextMenu.VisibleList}}" />
        <Setter Property="ShowInputGestures" Value="False" />
    </Style>
    <Style
        x:Key="TabContextMenuStyle"
        BasedOn="{StaticResource BaseContextMenuStyle}"
        TargetType="controls:AdbContextMenu">
        <Setter Property="ItemsSource" Value="{Binding Source={x:Static Member=viewmodels:TabContextMenu.VisibleList}}" />
    </Style>
    <Style
        x:Key="PathBoxContextMenuStyle"
        BasedOn="{StaticResource BaseContextMenuStyle}"
        TargetType="controls:AdbContextMenu">
        <Setter Property="ItemsSource" Value="{Binding Source={x:Static Member=viewmodels:PathContextMenu.List}}" />
    </Style>
    <ItemsPanelTemplate x:Key="VerticalItemsPanel">
        <WrapPanel FlowDirection="RightToLeft" Orientation="Vertical" />
    </ItemsPanelTemplate>
    <Style
        x:Key="LogControlsPanelStyle"
        BasedOn="{StaticResource AdbToolBarStyle}"
        TargetType="controls:AdbMenu">
        <Setter Property="ItemsControl.ItemsSource" Value="{Binding Source={x:Static Member=viewmodels:LogControls.List}}" />
        <Setter Property="ItemsPanel" Value="{StaticResource VerticalItemsPanel}" />
        <Setter Property="helpers:MenuHelper.ItemMargin" Value="3" />
        <Setter Property="helpers:MenuHelper.ItemPadding" Value="9,7" />
        <Setter Property="helpers:MenuHelper.IsButtonMenu" Value="True" />
    </Style>
</ResourceDictionary>